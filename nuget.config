<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline build: packages are restored ONLY from the vendored feed in ./packages.
  To refresh that feed (online), run: tools\fetch-dependencies.ps1 -Only packages
-->
<configuration>
  <packageSources>
    <clear />
    <add key="falcon-offline" value="packages" />
  </packageSources>
</configuration>
